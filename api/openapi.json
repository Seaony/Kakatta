{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "Kakatta 接口",
    "version": "1.0.0",
    "description": "字段使用小写蛇形命名，时间为 UTC Unix 整数毫秒。成功直接返回描述中的值；失败统一返回 ErrorEnvelope。初始化、登录和验证码端点校验各自凭据，其余业务、描述和事件流都要求会话或 Bearer 令牌。重复、冲突的认证凭据直接拒绝，不回退选择较弱凭据。浏览器写操作统一检查同源，不另发 CSRF 令牌。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "安全",
      "description": "初始化、登录和安全设置。"
    },
    {
      "name": "设置",
      "description": "设置值及元数据。"
    },
    {
      "name": "系统",
      "description": "健康检查、事件流和接口描述。"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "summary": "检查服务是否可用",
        "description": "检查服务是否可用",
        "tags": [
          "系统"
        ],
        "security": [],
        "x-authentication": "none",
        "responses": {
          "200": {
            "description": "服务可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReady"
                }
              }
            }
          },
          "503": {
            "description": "服务不可用；不披露内部原因。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "operationId": "getSetupStatus",
