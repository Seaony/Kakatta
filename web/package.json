{
  "name": "kakatta-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "browserslist": ["Safari >= 16", "ios_saf >= 16", "Chrome >= 111", "Firefox >= 114", "Edge >= 111"],
  "scripts": {
    "dev": "bun run --bun vite --host 127.0.0.1",
    "generate:api": "bun scripts/generate-api.ts",
    "generate:routes": "bun scripts/generate-routes.ts",
    "check:generated": "bun scripts/check-generated.ts",
    "check:locales": "bun scripts/check-locales.ts",
    "typecheck": "bun run generate:routes && bun run --bun tsc -b --pretty false && bun run --bun tsc -p dev/tsconfig.json --pretty false",
    "build": "bun run typecheck && bun run --bun vite build",
    "test": "bun test",
    "check": "bun run check:generated && bun run check:locales && bun run typecheck && bun run test && bun run --bun vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "i18next": "27.1.1",
    "openapi-fetch": "0.16.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-generator": "1.168.0",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/bun": "1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "patchedDependencies": {
    "vite@8.3.7": "patches/vite@8.3.7.patch"
  }
}
